rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // ── users/{userId} ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false; // never allow client-side user deletion
    }

    // ── businesses/{userId} ───────────────────────────────────────────────────
    match /businesses/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── invoices/{invoiceId} ──────────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
    }

    // ── customers/{customerId} ────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
    }

    // ── products/{productId} ─────────────────────────────────────────────────
    match /products/{productId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
    }

    // ── quotations/{quotationId} ──────────────────────────────────────────────
    match /quotations/{quotationId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
    }

    // ── payments/{paymentId} ─────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
    }

    // ── otpTokens/{email} ─────────────────────────────────────────────────────
    // No client access — read/write only via Cloud Functions (Admin SDK)
    match /otpTokens/{email} {
      allow read, write: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
