rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Business logos: logos/{userId}/{filename} ────────────────────────────
    match /logos/{userId}/{allPaths=**} {
      allow read: if true; // logos are public (used in PDF/invoices)
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // 5 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // ── Generated PDFs: pdfs/{userId}/{filename} ─────────────────────────────
    match /pdfs/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // written only by Cloud Functions (Admin SDK)
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
